# Backend environment variables — copy to ".env" and fill in.

# LLM provider (any OpenAI-compatible endpoint). Default is Groq (free tier).
# Get a free key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Local embedding model for retrieval (runs on-device via fastembed, no key).
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Token protecting the admin-only /refresh endpoint (set to a strong secret).
ADMIN_TOKEN=change-me
