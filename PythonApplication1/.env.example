# Backend environment variables — copy to ".env" and fill in.

# Gemini API key (free, from https://aistudio.google.com/apikey).
# Used for all LLM reasoning/synthesis via the OpenAI-compatible endpoint.
GEMINI_API_KEY=

# Gemini OpenAI-compatible endpoint + model (defaults are fine).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# Local embedding model for retrieval (runs on-device via fastembed, no key).
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Token protecting the admin-only /refresh endpoint (set to a strong secret).
ADMIN_TOKEN=change-me
